{
  "name": "context-meter-for-claude-code",
  "displayName": "Context Meter for Claude Code",
  "description": "Unofficial, not affiliated with Anthropic. Context, session tokens, 5-hour and weekly limits and usage history for Claude Code, right below the Claude Code chat. 100% local.",
  "icon": "media/icon.png",
  "version": "0.5.0",
  "publisher": "manuelCebreiro",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/ManuelCebreiro/claude_context_meter" },
  "homepage": "https://github.com/ManuelCebreiro/claude_context_meter#readme",
  "bugs": { "url": "https://github.com/ManuelCebreiro/claude_context_meter/issues" },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other", "Visualization"],
  "keywords": ["claude", "claude-code", "tokens", "context", "usage", "limits", "rate limit", "cost"],
  "main": "./src/extension.js",
  "l10n": "./l10n",
  "scripts": { "test": "node --test \"test/*.test.js\"" },
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      { "command": "claudeMeter.openPanel", "category": "Claude Meter", "title": "%command.openPanel%" },
      { "command": "claudeMeter.refresh", "category": "Claude Meter", "title": "%command.refresh%" },
      { "command": "claudeMeter.showView", "category": "Claude Meter", "title": "%command.showView%" }
    ],
    "views": {
      "claude-sidebar-secondary": [
        { "type": "webview", "id": "claudeMeter.view", "name": "%view.name%" }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "claudeMeter.showCost": { "type": "boolean", "default": true, "description": "%config.showCost%" },
        "claudeMeter.contextWindow": { "type": "number", "default": 0, "description": "%config.contextWindow%" },
        "claudeMeter.warningPercent": { "type": "number", "default": 60, "description": "%config.warningPercent%" },
        "claudeMeter.errorPercent": { "type": "number", "default": 80, "description": "%config.errorPercent%" },
        "claudeMeter.statusBar": {
          "type": "string", "default": "all", "enum": ["all", "context", "none"],
          "enumDescriptions": ["%config.statusBar.all%", "%config.statusBar.context%", "%config.statusBar.none%"],
          "description": "%config.statusBar%"
        },
        "claudeMeter.showBlock": { "type": "boolean", "default": true, "description": "%config.showBlock%" },
        "claudeMeter.blockWarnRatio": { "type": "number", "default": 0.8, "description": "%config.blockWarnRatio%" },
        "claudeMeter.saveToDisk": { "type": "boolean", "default": true, "description": "%config.saveToDisk%" },
        "claudeMeter.pollMs": { "type": "number", "default": 1500, "description": "%config.pollMs%" },
        "claudeMeter.priceOverrides": { "type": "object", "default": {}, "description": "%config.priceOverrides%" }
      }
    }
  }
}
